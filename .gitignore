# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
coverage.xml
htmlcov/
.import_linter_cache/

# bhoot runtime data (caches, page images, OCR results, checkpoints, training logs)
.bhoot/

# Secrets
.env
.env.*
!.env.example

# Never commit real customer documents. Only synthetic data under evals/ and tests/data/.
*.pdf
*.png
*.jpg
*.jpeg
*.tif
*.tiff
!tests/data/**/*.pdf
!tests/data/**/*.png
!tests/data/**/*.jpg
!evals/**/*.pdf
!evals/**/*.png
!evals/**/*.jpg

# Scanned eval sets are large (tens of MB) and fully reproducible:
#   python -m tools.synth scans --count 10 --clean
evals/*_scans/

# Code only in this repository: no documentation (design docs, guides, notes).
# README.md stays because pyproject.toml uses it as the package description.
docs/
*.md
!README.md
*.docx
*.pptx

# Editors / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
